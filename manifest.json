{
  "manifest_version": 3,
  "name": "YouTube Play Assist",
  "version": "1.0.0",
  "description": "Adds playback speed controls, 10-second rewind and forward buttons, and A–B looping to YouTube.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "playback-utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
